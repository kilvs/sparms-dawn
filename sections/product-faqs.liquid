{%- if section.settings.show_section -%}
<section class="product_faqs_section">
  <div class="padding-global padding-section-large">
    <div class="container-large">
      <div class="product_faqs_component">
        <div class="component_heading_split">
          <h2>{{ section.settings.heading | escape }}</h2>
          <div class="max-width-small">
            {{ section.settings.description }}
          </div>
        </div>
        <div class="spacer-xxlarge"></div>
        <div class="component_faq_component">
          <div class="component_faq_wrapper">
            {%- for block in section.blocks -%}
              <div class="component_faq_item" {{ block.shopify_attributes }}>
                <div class="component_faq_title_wrapper">
                  <div class="component_faq_title">
                    <div class="component_faq_icon is-title"></div>
                    <div class="component_faq_title-text">{{ block.settings.question | escape }}</div>
                  </div>
                  <div class="component_faq_icon_wrapper">
                    <div class="component_faq_icon_vertical"></div>
                    <div class="component_faq_icon_horizontal"></div>
                  </div>
                </div>
                <div class="component_faq_content_wrapper">
                  <div class="component_faq_content">
                    <div class="component_faq_icon is-content"></div>
                    <div class="text-size-medium">{{ block.settings.answer }}</div>
                  </div>
                </div>
              </div>
            {%- else -%}
              <div class="component_faq_item">
                <div class="component_faq_title_wrapper">
                  <div class="component_faq_title">
                    <div class="component_faq_icon is-title"></div>
                    <div class="component_faq_title-text">Add FAQ blocks in the theme editor</div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
          <div class="hide w-embed w-script">
            <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
            <style>
/* --- BASE STYLES --- */
.component_faq_item {
  cursor: pointer;
  overflow: hidden;
}
.component_faq_icon_vertical {
  transition: height 0.4s ease;
}
.component_faq_title {
  transition: font-weight 0.3s ease;
}
.component_faq_content_wrapper {
  height: 0;
  overflow: hidden;
  opacity: 0;
}
/* --- ACTIVE CLASS OVERRIDES --- */
.component_faq_item.is-active .component_faq_icon_vertical {
  height: 0%;
}
.component_faq_item.is-active .component_faq_icon.is-title {
  transform: scale(1);
}
.component_faq_item.is-active .component_faq_title {
  font-weight: 600;
}
.is-active .component_faq_title-text {
  margin-left: 0.5rem;
}
            </style>
            <script>
document.addEventListener("DOMContentLoaded", () => {
  const faqItems = document.querySelectorAll(".component_faq_item");
  function openFaqItem(item) {
    const content = item.querySelector(".component_faq_content_wrapper");
    item.classList.add("is-active");
    gsap.to(content, { height: "auto", opacity: 1, duration: 0.5, ease: "power2.out" });
  }
  function closeFaqItem(item) {
    const content = item.querySelector(".component_faq_content_wrapper");
    item.classList.remove("is-active");
    gsap.to(content, { height: 0, opacity: 0, duration: 0.4, ease: "power2.inOut" });
  }
  faqItems.forEach((item) => {
    item.addEventListener("click", function () {
      if (this.classList.contains("is-active")) return;
      faqItems.forEach((otherItem) => {
        if (otherItem !== this && otherItem.classList.contains("is-active")) closeFaqItem(otherItem);
      });
      openFaqItem(this);
    });
  });
  if (faqItems.length > 0) {
    setTimeout(() => { openFaqItem(faqItems[0]); }, 100);
  }
});
            </script>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product FAQs",
  "tag": "section",
  "class": "shopify-section-product-faqs",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show this section", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Quick answers to the questions we hear most about Sparms.</p>" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question goes here?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer goes here.</p>" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Product FAQs",
      "blocks": [
        { "type": "faq", "settings": { "question": "How do I find my size?", "answer": "<p>Getting the right fit matters. Sparms come in a full range of sizes designed to move with, perform, and protect you. Check out our sizing guide in the menu and find your perfect layer.</p>" } },
        { "type": "faq", "settings": { "question": "How do I care for my Sparms products?", "answer": "<p>Cold machine wash, gentle cycle. Hang dry — no tumble dryer. Avoid bleach and fabric softener to preserve the compression and UPF protection.</p>" } },
        { "type": "faq", "settings": { "question": "Can I use my Sparms in the water?", "answer": "<p>Yes. Sparms perform in chlorinated pools and saltwater. Rinse with cool fresh water after each swim to extend the life of the fabric.</p>" } },
        { "type": "faq", "settings": { "question": "Where are your products manufactured?", "answer": "<p>Designed in Australia and manufactured by long-standing partners with full quality and ethical-sourcing oversight.</p>" } },
        { "type": "faq", "settings": { "question": "Can I return or exchange an item?", "answer": "<p>Unused items in original packaging can be returned within 30 days. See our returns policy in the footer for the full process.</p>" } }
      ]
    }
  ]
}
{% endschema %}
