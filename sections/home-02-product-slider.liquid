{%- if section.settings.show_section -%}
{%- assign source_collection = collections[section.settings.collection] -%}
{%- assign product_limit = section.settings.products_to_show | default: 8 -%}
      <section class="home_product-slide_section">
        <div class="padding-global padding-section-large">
          <div class="container-large">
            <div class="hide w-embed w-script">
              <script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('#is-product-{{ section.id }}', {
      spaceBetween: 16,
      navigation: {
        nextEl: '#product-swiper-next-{{ section.id }}',
        prevEl: '#product-swiper-prev-{{ section.id }}',
      },
      breakpoints: {
        0:   { enabled: false, slidesPerView: 'auto', spaceBetween: 0  },
        992: { enabled: true,  slidesPerView: 'auto', spaceBetween: 32 },
      },
    });
  });
</script>
              <script>
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root || !window.gsap) return;
    const triggers = root.querySelectorAll('.button.is-add-to-cart');
    const panels = root.querySelectorAll('.component_product-list_size-wrapper');
    gsap.set(panels, { autoAlpha: 0 });
    triggers.forEach((trigger, i) => {
      const panel = panels[i];
      if (!panel) return;
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        panels.forEach((p) => {
          if (p !== panel) gsap.to(p, { autoAlpha: 0, duration: 0.2, ease: 'power2.in' });
        });
        const isVisible = gsap.getProperty(panel, 'autoAlpha') === 1;
        gsap.to(panel, { autoAlpha: isVisible ? 0 : 1, duration: 0.3, ease: isVisible ? 'power2.in' : 'power2.out' });
      });
    });
    document.addEventListener('click', (e) => {
      const inside = [...triggers, ...panels].some(el => el.contains(e.target));
      if (!inside) gsap.to(panels, { autoAlpha: 0, duration: 0.2, ease: 'power2.in' });
    });
  });
</script>
            </div>
            <div class="component_heading_split is-single-row">
              <h2 class="text-color-white">{{ section.settings.heading | escape }}</h2>
              <p class="text-color-white text-size-medium">{{ section.settings.description }}</p>
            </div>
            <div class="spacer-xlarge"></div>
            <div id="is-product-{{ section.id }}" class="swiper is-product">
              <div class="swiper-wrapper is-product">
                {%- if source_collection.products_count > 0 -%}
                  {%- for product in source_collection.products limit: product_limit -%}
                    {%- assign size_option = nil -%}
                    {%- for opt in product.options_with_values -%}
                      {%- if opt.name == 'Size' -%}{%- assign size_option = opt -%}{%- endif -%}
                    {%- endfor -%}
                    <div class="swiper-slide is-product">
                      <div class="component_product-list_card">
                        <div class="component_product-list_img-wrap">
                          <a href="{{ product.url }}" class="component_product-list_ilink w-inline-block">
                            {%- if product.featured_image != blank -%}
                              {{ product.featured_image | image_url: width: 648 | image_tag:
                                sizes: '(max-width: 648px) 100vw, 648px',
                                widths: '500,648',
                                loading: 'lazy',
                                class: 'component_product-list_img',
                                alt: product.title
                              }}
                            {%- else -%}
                              <img sizes="(max-width: 648px) 100vw, 648px" srcset="{{ 'Product-Image-placeholder-p-500.webp' | asset_url }} 500w, {{ 'Product-Image-placeholder.webp' | asset_url }} 648w" alt="" src="{{ 'Product-Image-placeholder.webp' | asset_url }}" loading="lazy" class="component_product-list_img">
                            {%- endif -%}
                          </a>
                          {%- if section.settings.show_size_picker and size_option -%}
                            <div class="component_product-list_size-wrapper">
                              <div class="text-size-small text-color-white">Select a Size</div>
                              <div class="component_product-list_size-list">
                                {%- for value in size_option.values -%}
                                  {%- assign matched_variant = nil -%}
                                  {%- for v in product.variants -%}
                                    {%- if v.options contains value -%}{%- assign matched_variant = v -%}{%- break -%}{%- endif -%}
                                  {%- endfor -%}
                                  <button class="component_product-list_size" data-cart-quick-add="{{ matched_variant.id }}" {% unless matched_variant.available %}disabled{% endunless %}>
                                    <div>{{ value | escape }}</div>
                                  </button>
                                {%- endfor -%}
                              </div>
                            </div>
                          {%- endif -%}
                        </div>
                        <div class="component_product-list_content">
                          <a href="{{ product.url }}" class="w-inline-block">
                            <div class="text-size-medium text-weight-semibold">{{ product.title | escape }}</div>
                          </a>
                          <div class="text-size-medium">{{ product.price | money }}</div>
                          {%- if section.settings.show_color_swatches -%}
                            {%- assign color_option = nil -%}
                            {%- for opt in product.options_with_values -%}
                              {%- if opt.name == 'Color' or opt.name == 'Colour' -%}{%- assign color_option = opt -%}{%- endif -%}
                            {%- endfor -%}
                            {%- if color_option -%}
                              <div class="component_product-list_colors">
                                {%- for value in color_option.values -%}
                                  <button class="component_product-list_color-wrap" aria-label="{{ value | escape }}">
                                    <div class="component_product-list_color" style="background-color: {{ value | downcase | handle }};"></div>
                                  </button>
                                {%- endfor -%}
                              </div>
                            {%- endif -%}
                          {%- endif -%}
                        </div>
                        <button class="button is-add-to-cart" data-product-add aria-label="Add {{ product.title | escape }} to cart">
                          <div class="icon-embed-blogs w-embed">
                            <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img">
                              <path d="M10.5 21C11.3284 21 12 20.3284 12 19.5C12 18.6716 11.3284 18 10.5 18C9.67157 18 9 18.6716 9 19.5C9 20.3284 9.67157 21 10.5 21Z" fill="#0A0A0A"></path>
                              <path d="M17.5 21C18.3284 21 19 20.3284 19 19.5C19 18.6716 18.3284 18 17.5 18C16.6716 18 16 18.6716 16 19.5C16 20.3284 16.6716 21 17.5 21Z" fill="#0A0A0A"></path>
                              <path d="M13 13H15V10.01H17.99V8.01003H15V5.03003H13V8.01003H10.01V10.01H13V13Z" fill="black"></path>
                              <path d="M10 17H18C18.2014 16.9994 18.398 16.938 18.564 16.8238C18.7299 16.7096 18.8575 16.5479 18.93 16.36L21.76 9H19.62L17.31 15H10.67L6.18 4.23C6.02776 3.86507 5.77077 3.55344 5.44149 3.33452C5.11221 3.11559 4.72542 2.99918 4.33 3H2V5H4.33L9.08 16.38C9.15502 16.5626 9.28242 16.719 9.44614 16.8293C9.60986 16.9396 9.80257 16.999 10 17Z" fill="black"></path>
                            </svg>
                          </div>
                          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                        </button>
                      </div>
                    </div>
                  {%- endfor -%}
                {%- else -%}
                  <div class="swiper-slide is-product">
                    <div class="component_product-list_card">
                      <div class="component_product-list_img-wrap">
                        <img sizes="(max-width: 648px) 100vw, 648px" srcset="{{ 'Product-Image-placeholder-p-500.webp' | asset_url }} 500w, {{ 'Product-Image-placeholder.webp' | asset_url }} 648w" alt="" src="{{ 'Product-Image-placeholder.webp' | asset_url }}" loading="lazy" class="component_product-list_img">
                      </div>
                      <div class="component_product-list_content">
                        <div class="text-size-medium text-weight-semibold">Pick a collection in the theme editor</div>
                        <div class="text-size-medium">$—</div>
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              </div>
              <div class="swiper_arrow_wrapper hide-tablet">
                <div id="product-swiper-prev-{{ section.id }}" class="swiper_arrow">
                  <div class="icon-embed-blogs w-embed">
                    <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img">
                      <path d="M12.7069 17.293L8.41394 13H17.9999V11H8.41394L12.7069 6.70697L11.2929 5.29297L4.58594 12L11.2929 18.707L12.7069 17.293Z" fill="currentColor"></path>
                    </svg>
                  </div>
                </div>
                <div id="product-swiper-next-{{ section.id }}" class="swiper_arrow">
                  <div class="icon-embed-blogs is-reversed w-embed">
                    <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img">
                      <path d="M12.7069 17.293L8.41394 13H17.9999V11H8.41394L12.7069 6.70697L11.2929 5.29297L4.58594 12L11.2929 18.707L12.7069 17.293Z" fill="currentColor"></path>
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
{%- endif -%}

{% schema %}
{
  "name": "Home — Product slider",
  "tag": "section",
  "class": "shopify-section-home-product-slider",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show this section", "default": true },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "LOCK IN PERFORMANCE" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Discover the next generation in skin care that plays as hard as you do.</p>" },
    { "type": "header", "content": "Products" },
    { "type": "collection", "id": "collection", "label": "Source collection", "info": "Products from this collection populate the slider." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_size_picker", "label": "Show size picker on hover", "default": true, "info": "Renders the product's Size option values as quick-add buttons (uses Dawn cart bridge)." },
    { "type": "checkbox", "id": "show_color_swatches", "label": "Show color swatches", "default": true, "info": "Renders the product's Color/Colour option values as swatch dots." }
  ],
  "presets": [
    {
      "name": "Home — Product slider"
    }
  ]
}
{% endschema %}
