{%- if section.settings.show_section -%}
      <section class="component_feature_section">
        <div class="component_feature_top">
          <div class="component_feature_logo-wrap">
            {%- if section.settings.wordmark != blank -%}
              {{ section.settings.wordmark | image_url: width: 2160 | image_tag:
                loading: 'lazy',
                sizes: '100vw',
                widths: '500,800,1080,1600,2000,2160'
              }}
            {%- else -%}
              <img src="{{ 'sparms-logo-wordmark.png' | asset_url }}" loading="lazy" sizes="100vw" srcset="{{ 'sparms-logo-wordmark-p-500.png' | asset_url }} 500w, {{ 'sparms-logo-wordmark-p-800.png' | asset_url }} 800w, {{ 'sparms-logo-wordmark-p-1080.png' | asset_url }} 1080w, {{ 'sparms-logo-wordmark-p-1600.png' | asset_url }} 1600w, {{ 'sparms-logo-wordmark-p-2000.png' | asset_url }} 2000w, {{ 'sparms-logo-wordmark.png' | asset_url }} 2160w" alt="">
            {%- endif -%}
          </div>
          <div class="spacer-xxlarge"></div>
          <div class="padding-global">
            <div class="container-large">
              <div class="component_heading_split">
                <h2>{{ section.settings.heading | escape }}</h2>
                <div class="component_heading_description">
                  {{ section.settings.description }}
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="component_feature_body">
          <div class="padding-global padding-section-large">
            <div class="container-large">
              <div class="component_feature_body-content">
                <div class="hide w-embed w-script">
                  <script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('#is-feature-{{ section.id }}', {
      spaceBetween: 16,
      navigation: {
        nextEl: '#feature-swiper-next-{{ section.id }}',
        prevEl: '#feature-swiper-prev-{{ section.id }}',
      },
      breakpoints: {
        0: { enabled: true, slidesPerView: 1, spaceBetween: 16 },
        992: { enabled: false, slidesPerView: 'auto', spaceBetween: 32 },
      },
    });
  });
</script>
                </div>
                <div class="component_feature_swiper-wrap">
                  <div id="is-feature-{{ section.id }}" class="swiper is-feature">
                    <div class="swiper-wrapper is-feature">
                      {%- for block in section.blocks -%}
                        {%- assign right_aligned = false -%}
                        {%- if block.settings.alignment == 'right' -%}{%- assign right_aligned = true -%}{%- endif -%}
                        <div class="swiper-slide{% if forloop.first == false %} is-feature{% endif %}" {{ block.shopify_attributes }}>
                          <div class="component_feature_card{% if right_aligned %} is-feature-right{% endif %}">
                            <div class="component_feature_title-wrap{% if right_aligned %} is-right-aligned{% endif %}">
                              {%- if right_aligned -%}
                                <div class="home_feature_icon-wrap w-embed">
                                  <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 13 13" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img">
                                    <circle cx="6.5" cy="6.5" r="6.5" fill="currentColor"></circle>
                                  </svg>
                                </div>
                                <h3 class="home_feature_title">{{ block.settings.title | escape }}</h3>
                              {%- else -%}
                                <h3 class="home_feature_title">{{ block.settings.title | escape }}</h3>
                                <div class="home_feature_icon-wrap w-embed">
                                  <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 13 13" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img">
                                    <circle cx="6.5" cy="6.5" r="6.5" fill="currentColor"></circle>
                                  </svg>
                                </div>
                              {%- endif -%}
                            </div>
                            <div class="component_feature_card-body{% if right_aligned %} is-right-aligned{% endif %}">
                              {{ block.settings.body }}
                            </div>
                          </div>
                        </div>
                      {%- else -%}
                        <div class="swiper-slide">
                          <div class="component_feature_card">
                            <div class="component_feature_title-wrap">
                              <h3 class="home_feature_title">Add Feature blocks in the theme editor</h3>
                            </div>
                          </div>
                        </div>
                      {%- endfor -%}
                    </div>
                  </div>
                  <div class="swiper_arrow_wrapper is-feature">
                    <div id="feature-swiper-prev-{{ section.id }}" class="swiper_arrow is-dark">
                      <div class="icon-embed-blogs w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img"><path d="M12.7069 17.293L8.41394 13H17.9999V11H8.41394L12.7069 6.70697L11.2929 5.29297L4.58594 12L11.2929 18.707L12.7069 17.293Z" fill="currentColor"></path></svg></div>
                    </div>
                    <div id="feature-swiper-next-{{ section.id }}" class="swiper_arrow is-dark">
                      <div class="icon-embed-blogs is-reversed w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img"><path d="M12.7069 17.293L8.41394 13H17.9999V11H8.41394L12.7069 6.70697L11.2929 5.29297L4.58594 12L11.2929 18.707L12.7069 17.293Z" fill="currentColor"></path></svg></div>
                    </div>
                  </div>
                </div>
                {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
                  <div class="button-group">
                    {%- if section.settings.primary_label != blank -%}
                      <a href="{{ section.settings.primary_url | default: routes.collections_url }}" class="button is-secondary is-icon w-inline-block">
                        <div class="button-icon w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 13 13" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img"><circle cx="6.5" cy="6.5" r="6.5" fill="currentColor"></circle></svg></div>
                        <div>{{ section.settings.primary_label | escape }}</div>
                      </a>
                    {%- endif -%}
                    {%- if section.settings.secondary_label != blank -%}
                      <a href="{{ section.settings.secondary_url | default: routes.collections_url }}" class="button is-link is-icon w-inline-block">
                        <div>{{ section.settings.secondary_label | escape }}</div>
                        <div class="icon-embed-blogs w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img"><path d="M9.70697 16.9496L15.414 11.2426L9.70697 5.53564L8.29297 6.94964L12.586 11.2426L8.29297 15.5356L9.70697 16.9496Z" fill="currentColor"></path></svg></div>
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
          <div class="component_feature_body-img-wrap">
            {%- if section.settings.background_image != blank -%}
              {{ section.settings.background_image | image_url: width: 2160 | image_tag:
                loading: 'lazy',
                sizes: '100vw',
                widths: '500,800,1080,1600,2000,2160',
                class: 'home_feature_body-img'
              }}
            {%- else -%}
              <img src="{{ 'Feature-background-Image.webp' | asset_url }}" loading="lazy" sizes="100vw" srcset="{{ 'Feature-background-Image-p-500.webp' | asset_url }} 500w, {{ 'Feature-background-Image-p-800.webp' | asset_url }} 800w, {{ 'Feature-background-Image-p-1080.webp' | asset_url }} 1080w, {{ 'Feature-background-Image-p-1600.webp' | asset_url }} 1600w, {{ 'Feature-background-Image-p-2000.webp' | asset_url }} 2000w, {{ 'Feature-background-Image.webp' | asset_url }} 2160w" alt="" class="home_feature_body-img">
            {%- endif -%}
          </div>
        </div>
      </section>
{%- endif -%}

{% schema %}
{
  "name": "Feature",
  "tag": "section",
  "class": "shopify-section-component-feature",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show this section", "default": true },
    { "type": "header", "content": "Heading" },
    { "type": "image_picker", "id": "wordmark", "label": "Brand wordmark", "info": "Shown above the heading. Leave empty to keep the Sparms wordmark default." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "the sporting advantage" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>The Original sun sleeve, and the choice of champions, Sparms is trusted by elite athletes worldwide. Our lightweight, breathable fabrics are designed to enhance, not limit. Get the best protection for your every day.</p>" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "View collection" },
    { "type": "url", "id": "primary_url", "label": "Primary button URL" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Shop All" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button URL" },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "background_image", "label": "Background image", "info": "Wide image behind the swiper. Leave empty for the default." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Feature title" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p class=\"paragraph\">Describe this feature in a sentence or two.</p>" },
        {
          "type": "select",
          "id": "alignment",
          "label": "Title alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left",
          "info": "Webflow source alternates left/right per card."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Feature",
      "blocks": [
        { "type": "feature", "settings": { "title": "Proven SPF 50+ Protection", "body": "<p class=\"paragraph\">Claiming to have the best sun sleeves is bold, but we back it up. Every year, our products are independently certified and rigorously tested to give you the ultimate UV defence. When you choose Sparms, you’re choosing protection you can trust.</p>", "alignment": "left" } },
        { "type": "feature", "settings": { "title": "Stay Cool Under Pressure", "body": "<p class=\"paragraph\">Our proprietary process harnesses the moisture-wicking power of premium fabrics, delivering a cooling, effortless fit from the moment you put it on. Whether you’re under the midday sun or pushing through an intense session, our sleeves keep you fresh, focused and moving at your best.</p>", "alignment": "right" } },
        { "type": "feature", "settings": { "title": "The Style in SPF", "body": "<p class=\"paragraph\">Designed for athletes who demand more than just function, our sleeves keep you cool, protected, and looking sharp while you push your limits.</p>", "alignment": "left" } },
        { "type": "feature", "settings": { "title": "Built for Every Body", "body": "<p class=\"paragraph\">With a wide range of sizes, every piece stays in place, supporting your performance and letting you focus on the play. Engineered for every body and designed to look as sharp as it feels, Sparms keeps you ready for whatever the day throws at you.</p>", "alignment": "right" } }
      ]
    }
  ]
}
{% endschema %}
