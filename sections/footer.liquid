<div class="component_footer_section">
  <div class="padding-global padding-section-medium">
    <div class="container-large">
      <div class="component_footer_wrapper">
        <div class="component_footer_upper_wrapper">
          <div class="component_footer_upper_logo_wrapper">
            <a href="{{ routes.root_url }}" class="component_footer_logo w-inline-block" aria-label="{{ shop.name | escape }}">
              {%- if section.settings.footer_logo != blank -%}
                {{ section.settings.footer_logo | image_url: width: 400 | image_tag:
                  loading: 'lazy',
                  width: section.settings.footer_logo.width,
                  height: section.settings.footer_logo.height,
                  class: 'component_footer_logo_image',
                  alt: shop.name
                }}
              {%- else -%}
                <img loading="lazy" src="{{ 'footer-logo.svg' | asset_url }}" alt="{{ shop.name | escape }}" class="component_footer_logo_image">
              {%- endif -%}
            </a>

            <div class="component_footer_form_wrapper">
              {%- if section.settings.newsletter_heading != blank -%}
                <p>{{ section.settings.newsletter_heading }}</p>
                <div class="spacer-small"></div>
              {%- endif -%}

              <div class="component_footer_form_block w-form">
                {%- form 'customer', class: 'component_footer_form', id: 'wf-form-Subscribe-Form' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <input type="hidden" name="contact[accepts_marketing]" value="true">
                  <input
                    class="form_input is-footer w-input"
                    maxlength="256"
                    name="contact[email]"
                    placeholder="{{ section.settings.newsletter_placeholder | default: 'you@email.com' }}"
                    type="email"
                    required
                    autocomplete="email"
                    aria-label="{{ 'newsletter.label' | t | default: 'Email' }}">
                  <div class="button-group is-footer">
                    <button type="submit" class="button is-secondary is-icon is-alternate w-inline-block" aria-label="Subscribe">
                      <div class="button-icon w-embed">
                        <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 13 13" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img">
                          <circle cx="6.5" cy="6.5" r="6.5" fill="currentColor"></circle>
                        </svg>
                      </div>
                      <div>SUBMIT</div>
                    </button>
                  </div>
                  {%- render 'wf-form-states', form: form -%}
                {%- endform -%}
              </div>

              <div class="spacer-xxsmall"></div>
              {%- if section.settings.newsletter_disclaimer != blank -%}
                <p class="text-size-tiny">{{ section.settings.newsletter_disclaimer }}</p>
              {%- endif -%}
            </div>
          </div>

          <div class="component_footer_upper_menu_wrapper">
            {%- for block in section.blocks -%}
              {%- if block.type == 'menu' -%}
                <div class="component_footer_upper_menu" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <div class="text-weight-semibold">{{ block.settings.heading | escape }}</div>
                  {%- endif -%}
                  {%- if block.settings.menu != blank -%}
                    <div class="component_footer_upper_menu_link_wrapper">
                      {%- for link in block.settings.menu.links -%}
                        <a href="{{ link.url }}" class="component_footer_upper_menu_link">{{ link.title | escape }}</a>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- else -%}
              <div class="component_footer_upper_menu">
                <div class="text-weight-semibold">Shop All</div>
                <div class="component_footer_upper_menu_link_wrapper">
                  <a href="{{ routes.collections_url }}" class="component_footer_upper_menu_link">All Products</a>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        <div class="component_footer_divider"></div>

        <div class="component_footer_lower_wrapper">
          <div class="component_footer_lower_payment_wrapper">
            {%- if section.settings.show_payment_icons -%}
              <div class="component_footer_lower_payment">
                {%- for type in shop.enabled_payment_types -%}
                  {{ type | payment_type_svg_tag: class: 'component_footer_lower_payment_image' }}
                {%- endfor -%}
              </div>
            {%- endif -%}
            <div class="text-size-small">© {{ 'now' | date: '%Y' }} {{ shop.name }}</div>
          </div>

          <div class="component_footer_lower_terms_wrapper">
            {%- if section.settings.show_locale_picker -%}
              <div class="component_footer_lower_currency">
                <img loading="lazy" src="{{ 'au.webp' | asset_url }}" alt="" class="component_footer_lower_currency_image">
                <div>{{ shop.currency }} {{ cart.currency.symbol }}</div>
              </div>
            {%- endif -%}

            <div class="component_footer_lower_policy">
              {%- if shop.privacy_policy -%}<a href="{{ shop.privacy_policy.url }}" class="component_footer_lower_policy_link">{{ shop.privacy_policy.title }}</a>{%- endif -%}
              {%- if shop.terms_of_service -%}<a href="{{ shop.terms_of_service.url }}" class="component_footer_lower_policy_link">{{ shop.terms_of_service.title }}</a>{%- endif -%}
              {%- if shop.refund_policy -%}<a href="{{ shop.refund_policy.url }}" class="component_footer_lower_policy_link">{{ shop.refund_policy.title }}</a>{%- endif -%}
            </div>

            {%- assign has_social = false -%}
            {%- if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_twitter_link != blank or settings.social_linkedin_link != blank or settings.social_youtube_link != blank or settings.social_tiktok_link != blank -%}
              {%- assign has_social = true -%}
            {%- endif -%}
            {%- if has_social -%}
              <div class="component_footer_lower_social">
                {%- if settings.social_facebook_link != blank -%}<a href="{{ settings.social_facebook_link }}" class="component_footer_lower_policy_link" aria-label="Facebook">{%- render 'social-icon', platform: 'facebook' -%}</a>{%- endif -%}
                {%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}" class="component_footer_lower_policy_link" aria-label="Instagram">{%- render 'social-icon', platform: 'instagram' -%}</a>{%- endif -%}
                {%- if settings.social_twitter_link != blank -%}<a href="{{ settings.social_twitter_link }}" class="component_footer_lower_policy_link" aria-label="Twitter">{%- render 'social-icon', platform: 'twitter' -%}</a>{%- endif -%}
                {%- if settings.social_linkedin_link != blank -%}<a href="{{ settings.social_linkedin_link }}" class="component_footer_lower_policy_link" aria-label="LinkedIn">{%- render 'social-icon', platform: 'linkedin' -%}</a>{%- endif -%}
                {%- if settings.social_youtube_link != blank -%}<a href="{{ settings.social_youtube_link }}" class="component_footer_lower_policy_link" aria-label="YouTube">{%- render 'social-icon', platform: 'youtube' -%}</a>{%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer logo",
      "info": "Leave empty to keep the original Webflow SVG logo."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Stay connected with the latest updates"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder",
      "default": "you@email.com"
    },
    {
      "type": "text",
      "id": "newsletter_disclaimer",
      "label": "Disclaimer",
      "default": "By subscribing, you agree to our privacy policy and email terms"
    },
    {
      "type": "header",
      "content": "Lower row"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_locale_picker",
      "label": "Show currency flag",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop All" } },
        { "type": "menu", "settings": { "heading": "More" } }
      ]
    }
  ]
}
{% endschema %}
