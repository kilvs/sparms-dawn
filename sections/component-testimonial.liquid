{%- if section.settings.show_section -%}
{%- assign featured = section.blocks[0] -%}
      <section class="component_testimonial_section">
        <div class="padding-global padding-section-large">
          <div class="container-large">
            <div class="component_testimonial_wrapper">
              <div class="component_testimonial_title_wrapper">
                <div class="component_testimonial_title">
                  <h2 class="text-color-primary">{{ section.settings.heading | escape }}</h2>
                </div>
                <p class="text-color-primary">{{ section.settings.description }}</p>
              </div>
              <div class="component_testimonial_tabs_wrapper">
                <div class="component_testimonial_tabs_image_stack">
                  <div class="component_testimonial_tabs_image_wrapper">
                    <div class="component_testimonial_tabs_image_content_wrapper">
                      <div class="component_testimonial_tabs_image_icon w-embed">
                        <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 27 38" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img">
                          <path d="M13.125 37.5L15 33.75V28.125H24.375C24.8723 28.125 25.3492 27.9275 25.7008 27.5758C26.0525 27.2242 26.25 26.7473 26.25 26.25V23.2762C26.25 22.29 25.8487 21.3225 25.1512 20.625L22.5 17.9738V11.25C22.9973 11.25 23.4742 11.0525 23.8258 10.7008C24.1775 10.3492 24.375 9.87228 24.375 9.375V3.75C24.375 1.68187 22.6931 0 20.625 0H5.625C3.55687 0 1.875 1.68187 1.875 3.75V9.375C1.875 9.87228 2.07254 10.3492 2.42418 10.7008C2.77581 11.0525 3.25272 11.25 3.75 11.25V17.9738L1.09875 20.625C0.397176 21.3293 0.0022598 22.2822 0 23.2762V26.25C0 26.7473 0.197544 27.2242 0.549175 27.5758C0.900806 27.9275 1.37772 28.125 1.875 28.125H11.25V33.75L13.125 37.5ZM5.625 3.75H20.625V7.5H5.625V3.75ZM3.75 23.2762L6.95062 20.0756C7.12508 19.9018 7.26343 19.6952 7.35772 19.4677C7.452 19.2402 7.50036 18.9963 7.5 18.75V11.25H18.75V18.75C18.75 19.2488 18.9469 19.725 19.2994 20.0756L22.5 23.2762V24.375H3.75V23.2762Z" fill="currentColor"></path>
                        </svg>
                      </div>
                      <p id="testi-content-to" class="component_testimonial_tabs_image_content_text">{{ featured.settings.quote | default: '"Add your first testimonial block to begin."' }}</p>
                    </div>
                    <div class="component_testimonial_tabs_image_headshot_container">
                      <div class="component_testimonial_tabs_image_headshot_wrapper">
                        <img id="testi-image-to" loading="lazy" alt="{{ featured.settings.name | escape }}" src="{% if featured.settings.image != blank %}{{ featured.settings.image | image_url: width: 600 }}{% else %}{{ 'Ambassadors-Image.webp' | asset_url }}{% endif %}" class="component_testimonial_tabs_image_headshot">
                      </div>
                      <div class="component_testimonial_tabs_image_headshot_content">
                        <div class="component_testimonial_tabs_title">
                          <div class="component_testimonial_tabs_title_icon"></div>
                          <p id="testi-title-to" class="component_testimonial_tabs_image_headshot_content_title_content">{{ featured.settings.name | default: 'Featured testimonial' }}</p>
                        </div>
                        <div id="testi-position-to" class="component_testimonial_tabs_subtitle">{{ featured.settings.position }}</div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="component_testimonial_tabs">
                  {%- for block in section.blocks -%}
                    <div class="component_testimonial_tabs_item" {{ block.shopify_attributes }}>
                      <div class="component_testimonial_tabs_item_wrapper">
                        <div class="component_testimonial_tabs_title">
                          <div class="component_testimonial_tabs_item_icon"></div>
                          <p class="component_testimonial_tabs_title_text" data-testi-name>{{ block.settings.name | escape }}</p>
                        </div>
                        <div class="component_testimonial_tabs_subtitle is-link" data-testi-position>{{ block.settings.position | escape }}</div>
                      </div>
                      <div class="component_testimonial_tabs_item_content hide-desktop">
                        <div class="component_testimonial_tabs_image_headshot_container">
                          <div class="component_testimonial_tabs_image_headshot_wrapper">
                            <img loading="lazy" alt="{{ block.settings.name | escape }}" src="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 600 }}{% else %}{{ 'Ambassadors-Image.webp' | asset_url }}{% endif %}" class="component_testimonial_tabs_image_headshot" data-testi-image>
                          </div>
                          <div class="component_testimonial_tabs_image_headshot_content">
                            <div class="component_testimonial_tabs_title">
                              <div class="component_testimonial_tabs_title_icon"></div>
                              <p class="component_testimonial_tabs_image_headshot_content_title_content">{{ block.settings.name | escape }}</p>
                            </div>
                            <div class="component_testimonial_tabs_subtitle is-mobile">{{ block.settings.position | escape }}</div>
                          </div>
                        </div>
                        <div class="spacer-medium"></div>
                        <div class="component_testimonial_tabs_image_content_wrapper">
                          <div class="component_testimonial_tabs_image_icon w-embed">
                            <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 27 38" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img">
                              <path d="M13.125 37.5L15 33.75V28.125H24.375C24.8723 28.125 25.3492 27.9275 25.7008 27.5758C26.0525 27.2242 26.25 26.7473 26.25 26.25V23.2762C26.25 22.29 25.8487 21.3225 25.1512 20.625L22.5 17.9738V11.25C22.9973 11.25 23.4742 11.0525 23.8258 10.7008C24.1775 10.3492 24.375 9.87228 24.375 9.375V3.75C24.375 1.68187 22.6931 0 20.625 0H5.625C3.55687 0 1.875 1.68187 1.875 3.75V9.375C1.875 9.87228 2.07254 10.3492 2.42418 10.7008C2.77581 11.0525 3.25272 11.25 3.75 11.25V17.9738L1.09875 20.625C0.397176 21.3293 0.0022598 22.2822 0 23.2762V26.25C0 26.7473 0.197544 27.2242 0.549175 27.5758C0.900806 27.9275 1.37772 28.125 1.875 28.125H11.25V33.75L13.125 37.5ZM5.625 3.75H20.625V7.5H5.625V3.75ZM3.75 23.2762L6.95062 20.0756C7.12508 19.9018 7.26343 19.6952 7.35772 19.4677C7.452 19.2402 7.50036 18.9963 7.5 18.75V11.25H18.75V18.75C18.75 19.2488 18.9469 19.725 19.2994 20.0756L22.5 23.2762V24.375H3.75V23.2762Z" fill="currentColor"></path>
                            </svg>
                          </div>
                          <p class="text-size-large" data-testi-quote>{{ block.settings.quote }}</p>
                        </div>
                      </div>
                    </div>
                  {%- else -%}
                    <div class="component_testimonial_tabs_item">
                      <div class="component_testimonial_tabs_item_wrapper">
                        <p class="component_testimonial_tabs_title_text">Add testimonial blocks in the theme editor</p>
                      </div>
                    </div>
                  {%- endfor -%}
                </div>
              </div>
              <div class="hide w-embed w-script">
                <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
                <style>
.component_testimonial_tabs_item { cursor: pointer; }
.component_testimonial_tabs_item_wrapper {
  color: #666;
  font-weight: 400;
  transition: color 0.3s ease, font-weight 0.3s ease;
}
.component_testimonial_tabs_item.is-active .component_testimonial_tabs_item_icon { transform: scale(1); }
.is-active .component_testimonial_tabs_title_text { margin-left: 0.5rem; }
.component_testimonial_tabs_item.is-active .component_testimonial_tabs_item_wrapper {
  color: #000;
  font-weight: 700;
}
@media screen and (max-width: 991px) {
  .component_testimonial_tabs_item_content {
    height: 0;
    overflow: hidden;
    opacity: 0;
  }
}
                </style>
                <script>
document.addEventListener("DOMContentLoaded", () => {
  const root = document.getElementById("shopify-section-{{ section.id }}") || document;
  const tabs = root.querySelectorAll(".component_testimonial_tabs_item");
  const targets = {
    image: root.querySelector("#testi-image-to"),
    name: root.querySelector("#testi-title-to"),
    position: root.querySelector("#testi-position-to"),
    quote: root.querySelector("#testi-content-to"),
  };

  function updateFeatured(item, animate) {
    const src = {
      image: item.querySelector("[data-testi-image]"),
      name: item.querySelector("[data-testi-name]"),
      position: item.querySelector("[data-testi-position]"),
      quote: item.querySelector("[data-testi-quote]"),
    };
    const apply = () => {
      if (src.image && targets.image) targets.image.src = src.image.src;
      if (src.name && targets.name) targets.name.innerText = src.name.innerText;
      if (src.position && targets.position) targets.position.innerText = src.position.innerText;
      if (src.quote && targets.quote) targets.quote.innerText = src.quote.innerText;
    };
    if (animate && window.innerWidth > 991 && window.gsap) {
      const els = Object.values(targets).filter(Boolean);
      gsap.to(els, { opacity: 0, y: 10, duration: 0.3, stagger: 0.05, ease: "power2.in", onComplete: () => {
        apply();
        gsap.set(els, { y: -10 });
        gsap.to(els, { opacity: 1, y: 0, duration: 0.4, stagger: 0.08, ease: "power2.out" });
      }});
    } else {
      apply();
    }
  }

  function handleMobileAccordion(activeItem) {
    if (window.innerWidth > 991 || !window.gsap) return;
    tabs.forEach(tab => {
      const content = tab.querySelector(".component_testimonial_tabs_item_content");
      if (!content) return;
      if (tab !== activeItem) {
        gsap.to(content, { height: 0, opacity: 0, duration: 0.4, ease: "power2.inOut" });
      } else {
        gsap.to(content, { height: "auto", opacity: 1, duration: 0.5, ease: "power2.out" });
      }
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", function () {
      if (this.classList.contains("is-active")) return;
      tabs.forEach(t => t.classList.remove("is-active"));
      this.classList.add("is-active");
      updateFeatured(this, true);
      handleMobileAccordion(this);
    });
  });

  if (tabs.length > 0) {
    tabs[0].classList.add("is-active");
    updateFeatured(tabs[0], false);
    if (window.innerWidth <= 991 && window.gsap) {
      gsap.set(tabs[0].querySelector(".component_testimonial_tabs_item_content"), { height: "auto", opacity: 1 });
    }
  }
});
                </script>
              </div>
            </div>
          </div>
        </div>
      </section>
{%- endif -%}

{% schema %}
{
  "name": "Testimonial",
  "tag": "section",
  "class": "shopify-section-component-testimonial",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show this section", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "THE TOP CHOICE OF ELITE SPORTING CHAMPIONS" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Hear from the sporting champions who trust Sparms.</p>" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Athlete name" },
        { "type": "text", "id": "position", "label": "Position / sport", "default": "Sport, achievement" },
        { "type": "richtext", "id": "quote", "label": "Quote", "default": "<p>\"Why this athlete loves Sparms.\"</p>" },
        { "type": "image_picker", "id": "image", "label": "Headshot", "info": "Falls back to assets/Ambassadors-Image.webp." }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Testimonial",
      "blocks": [
        { "type": "testimonial", "settings": { "name": "Alyssa Healy",       "position": "Australian Women's Cricket Captain",        "quote": "<p>\"I was actually a customer before I became a part of SParms Cricket. Using SParms in my own training and daily life, I realised everyone needed this so when SParms reached out, we got the ball rolling as soon as we could.\"</p>" } },
        { "type": "testimonial", "settings": { "name": "Mitchell Starc",     "position": "Australian International Cricketer",         "quote": "<p>\"Cricket demands performance regardless of weather, with most of it under the scorching sun so protecting our skin is paramount. Partnering with SParms Cricket was a natural choice for us.\"</p>" } },
        { "type": "testimonial", "settings": { "name": "Marina Alex",        "position": "Golf Professional (LPGA), LPGA Winner",      "quote": "<p>\"They are a fantastic product, I've been wearing them for few seasons to protect my skin from the sun. Their shawls are absolutely incredible, super comfortable, you don't even know you have them on.\"</p>" } },
        { "type": "testimonial", "settings": { "name": "Karrie Webb",        "position": "Golf Professional (LPGA), Previous World #1", "quote": "<p>\"After a very hot &amp; sunny start to season I'm grateful for my @SParms_UPF50. Wish I had been wearing this since I was a kid. Huge difference.\"</p>" } },
        { "type": "testimonial", "settings": { "name": "Mo Martin",          "position": "Golf Professional (LPGA), LPGA Winner",      "quote": "<p>\"I've been on the LPGA for 8 years and I've been wearing SParms for a good majority of that. It has kept me happy and healthy under the sun.\"</p>" } },
        { "type": "testimonial", "settings": { "name": "So Yeon Ryu",        "position": "Golf Professional (LPGA), LPGA Winner",      "quote": "<p>\"I have zero idea of how I'm gonna protect my skin without SParms Sun Protection. SParms is an easy and safe way to protect your skin from the sun.\"</p>" } },
        { "type": "testimonial", "settings": { "name": "Brittany Lincicome", "position": "Golf Professional (LPGA), LPGA Winner",      "quote": "<p>\"Thank you SOOOO much to @SParms_UPF50 for my new shawl sleeves. Best sun protection ever!!!!! #Love\"</p>" } },
        { "type": "testimonial", "settings": { "name": "Zack Guthrie",       "position": "Professional AFL Player",                    "quote": "<p>\"The Sparms products help to keep me cool and comfortable during the hot summer months. It provides great protection whilst allowing me to perform at my best.\"</p>" } },
        { "type": "testimonial", "settings": { "name": "Jesse Levine",       "position": "Former Professional Tennis Player",          "quote": "<p>\"After playing professional tennis for 10 years, the SParms keep me protected from the sun with the most comfort and coolness.\"</p>" } },
        { "type": "testimonial", "settings": { "name": "Chloe Stewart",      "position": "Australian Lawn Bowls Champion",             "quote": "<p>\"SParms are essential every time I go on the bowls green. Super comfortable, lightweight, and always keep me cool!\"</p>" } }
      ]
    }
  ]
}
{% endschema %}
