{%- if section.settings.show_section -%}
      <section class="component_ambassadors_section">
        <div class="w-embed w-script">
          <style>
@media (min-width: 992px) and (max-width: 1239px) {
  .component_ambassadors_list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: start;
  }
  .component_ambassadors_list-item:nth-child(3n+2) {
    margin-top: 200px;
    margin-left: -25%;
  }
  .component_ambassadors_list-item { margin-bottom: -80px; }
  .component_ambassadors_list-item:nth-child(1),
  .component_ambassadors_list-item:nth-child(2),
  .component_ambassadors_list-item:nth-child(3) { margin-bottom: -120px; }
}
@media (min-width: 1240px) {
  .component_ambassadors_list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: start;
  }
  .component_ambassadors_list-item:nth-child(4n+2),
  .component_ambassadors_list-item:nth-child(4n+4) {
    margin-top: 200px;
    margin-left: -25%;
  }
  .component_ambassadors_list-item { margin-bottom: -80px; }
  .component_ambassadors_list-item:nth-child(1),
  .component_ambassadors_list-item:nth-child(2),
  .component_ambassadors_list-item:nth-child(3) { margin-bottom: -120px; }
}
          </style>
          <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js"></script>
          <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js"></script>
          <script>
  document.addEventListener('DOMContentLoaded', () => {
    gsap.registerPlugin(ScrollTrigger);
    const mm = gsap.matchMedia();
    mm.add("(min-width: 992px)", () => {
      const wrapper = document.querySelector('.component_ambassadors_list');
      const cards = document.querySelectorAll('.component_ambassadors_list-item');
      cards.forEach((card, i) => {
        const isOdd = (i + 1) % 2 !== 0;
        gsap.to(card, {
          y: isOdd ? 80 : -80,
          ease: 'none',
          scrollTrigger: { trigger: wrapper, start: 'top bottom', end: 'bottom top', scrub: isOdd ? 2 : 1 },
        });
      });
      return () => { cards.forEach(card => gsap.set(card, { clearProps: 'y' })); };
    });
  });
</script>
        </div>
        <div class="padding-global padding-section-large">
          <div class="container-large">
            <div class="component_heading_split">
              <h2 class="text-color-primary">{{ section.settings.heading | escape }}</h2>
              <p class="text-color-primary">{{ section.settings.description }}</p>
            </div>
            <div class="spacer-xxlarge"></div>
            <div class="component_ambassadors_list">
              {%- for block in section.blocks -%}
                <div class="component_ambassadors_list-item" {{ block.shopify_attributes }}>
                  <div class="component_ambassadors_card">
                    <div class="component_ambassadors_img-wrap">
                      {%- if block.settings.image != blank -%}
                        {{ block.settings.image | image_url: width: 800 | image_tag:
                          loading: 'lazy',
                          class: 'component_ambassadors_img',
                          alt: block.settings.name
                        }}
                      {%- else -%}
                        <img loading="lazy" src="{{ 'Ambassadors-Image.webp' | asset_url }}" alt="" class="component_ambassadors_img">
                      {%- endif -%}
                    </div>
                    <div class="component_ambassadors_content">
                      <div class="component_ambassadors_name-wrap">
                        <div class="component_collection_icon-wrap">
                          <div class="icon-embed-xxsmall w-embed">
                            <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 17 17" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img">
                              <circle cx="8.5" cy="8.5" r="8.5" fill="currentColor"></circle>
                            </svg>
                          </div>
                        </div>
                        <div class="text-size-medium text-style-allcaps">{{ block.settings.name | escape }}</div>
                      </div>
                      <div class="component_ambasadors_tag-wrap">
                        {%- if block.settings.sport != blank -%}
                          <div class="component_ambassadors_tag">
                            <div>{{ block.settings.sport | escape }}</div>
                          </div>
                        {%- endif -%}
                        {%- if block.settings.country_code != blank -%}
                          <div class="component_ambassadors_tag">
                            <div class="compnent_ambassadors_country-icon">
                              {%- if block.settings.country_flag != blank -%}
                                {{ block.settings.country_flag | image_url: width: 40 | image_tag: loading: 'lazy', alt: block.settings.country_code }}
                              {%- else -%}
                                <img loading="lazy" src="{{ 'au.webp' | asset_url }}" alt="">
                              {%- endif -%}
                            </div>
                            <div>{{ block.settings.country_code | escape }}</div>
                          </div>
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
                </div>
              {%- else -%}
                <div class="component_ambassadors_list-item">
                  <div class="component_ambassadors_card">
                    <div class="component_ambassadors_content">
                      <div class="text-size-medium text-style-allcaps">Add ambassador blocks in the theme editor</div>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
              <div class="component_ambassadors_list-item"></div>
            </div>
          </div>
        </div>
      </section>
{%- endif -%}

{% schema %}
{
  "name": "Ambassadors",
  "tag": "section",
  "class": "shopify-section-component-ambassadors",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show this section", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "OUR AMBASSADORS" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>A powerhouse collective from every corner of sport, our ambassadors wear Sparms with pride in training, on the field, and at every competition.</p>" }
  ],
  "blocks": [
    {
      "type": "ambassador",
      "name": "Ambassador",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Portrait", "info": "Falls back to assets/Ambassadors-Image.webp." },
        { "type": "text", "id": "name", "label": "Name", "default": "Angel Yin" },
        { "type": "text", "id": "sport", "label": "Sport", "default": "Golf" },
        { "type": "image_picker", "id": "country_flag", "label": "Country flag", "info": "Small flag icon. Falls back to assets/au.webp." },
        { "type": "text", "id": "country_code", "label": "Country code", "default": "AUS" }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Ambassadors",
      "blocks": [
        { "type": "ambassador", "settings": { "name": "Angel Yin",   "sport": "Golf",    "country_code": "AUS" } },
        { "type": "ambassador", "settings": { "name": "Angel Yin",   "sport": "Golf",    "country_code": "AUS" } },
