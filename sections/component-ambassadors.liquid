        { "type": "ambassador", "settings": { "name": "Angel Yin",   "sport": "Golf",    "country_code": "AUS" } },
        { "type": "ambassador", "settings": { "name": "Angel Yin",   "sport": "Golf",    "country_code": "AUS" } },
        { "type": "ambassador", "settings": { "name": "Angel Yin",   "sport": "Golf",    "country_code": "AUS" } },
        { "type": "ambassador", "settings": { "name": "Angel Yin",   "sport": "Golf",    "country_code": "AUS" } }
      ]
    }
  ]
}
