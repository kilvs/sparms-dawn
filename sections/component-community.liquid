{%- if section.settings.show_section -%}
      <section class="component_community_serction">
        <div class="padding-section-medium">
          <div class="padding-global">
            <div class="container-large">
              <div class="component_community_title_serction">
                <h2>{{ section.settings.heading | escape }}</h2>
                <p>{{ section.settings.subheading }}</p>
              </div>
            </div>
          </div>
          <div class="spacer-small"></div>
          <div class="hide w-embed w-script">
            <script>
  document.addEventListener('DOMContentLoaded', function() {
    const slideWidth = 16 * 16;
    const gap = 16;
    const needed = Math.ceil((window.innerWidth * 2) / (slideWidth + gap));
    new Splide('#community-{{ section.id }}', {
      type: 'loop',
      drag: 'free',
      gap: '1rem',
      autoWidth: true,
      arrows: false,
      pagination: false,
      clones: needed,
      autoScroll: {
        speed: {{ section.settings.scroll_speed | default: 0.3 }},
        pauseOnHover: true,
        pauseOnFocus: false,
      },
    }).mount(window.splide.Extensions);
  });
</script>
          </div>
          <div id="community-{{ section.id }}" class="splide">
            <div class="splide__track">
              <div class="splide__list">
                {%- for block in section.blocks -%}
                  <div class="splide__slide" {{ block.shopify_attributes }}>
                    <div class="component_community_image_wrapper">
                      {%- if block.settings.image != blank -%}
                        {{ block.settings.image | image_url: width: 600 | image_tag:
                          loading: 'lazy',
                          class: 'component_community_image',
                          alt: block.settings.alt_text
                        }}
                      {%- else -%}
                        <img loading="lazy" src="{{ 'community-image-1.webp' | asset_url }}" alt="" class="component_community_image">
                      {%- endif -%}
                    </div>
                  </div>
                {%- else -%}
                  <div class="splide__slide">
                    <div class="component_community_image_wrapper">
                      <img loading="lazy" src="{{ 'community-image-1.webp' | asset_url }}" alt="" class="component_community_image">
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          </div>
        </div>
      </section>
{%- endif -%}

{% schema %}
{
  "name": "Community",
  "tag": "section",
  "class": "shopify-section-component-community",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show this section", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "OUR community" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real athletes. Real protection. Real stories." },
    { "type": "range", "id": "scroll_speed", "label": "Auto-scroll speed", "min": 0.1, "max": 2, "step": 0.1, "default": 0.3 }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Falls back to community-image-1.webp." },
        { "type": "text", "id": "alt_text", "label": "Alt text" }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "Community",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
