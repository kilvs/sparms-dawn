{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "caption": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.descriptors.subtitle.value }}",
            "text_style": "subtitle"
          }
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "collapsible-row-0": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Materials",
            "icon": "leather",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & Returns",
            "icon": "truck",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-2": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Size & Fit",
            "icon": "ruler",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-3": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Care Instructions",
            "icon": "heart",
            "content": "",
            "page": ""
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "caption",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "collapsible-row-0",
        "collapsible-row-1",
        "collapsible-row-2",
        "collapsible-row-3",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "feature": {
      "type": "component-feature",
      "settings": {
        "show_section": true,
        "heading": "the sporting advantage",
        "description": "<p>The Original sun sleeve, and the choice of champions, Sparms is trusted by elite athletes worldwide. Our lightweight, breathable fabrics are designed to enhance, not limit. Get the best protection for your every day.</p>"
      }
    },
    "faqs": {
      "type": "product-faqs",
      "blocks": {
        "faq-0": { "type": "faq", "settings": { "question": "How do I find my size?", "answer": "<p>Getting the right fit matters. Sparms come in a full range of sizes designed to move with, perform, and protect you. Check out our sizing guide in the menu and find your perfect layer.</p>" } },
        "faq-1": { "type": "faq", "settings": { "question": "How do I care for my Sparms products?", "answer": "<p>Cold machine wash, gentle cycle. Hang dry — no tumble dryer. Avoid bleach and fabric softener to preserve the compression and UPF protection.</p>" } },
        "faq-2": { "type": "faq", "settings": { "question": "Can I use my Sparms in the water?", "answer": "<p>Yes. Sparms perform in chlorinated pools and saltwater. Rinse with cool fresh water after each swim to extend the life of the fabric.</p>" } },
        "faq-3": { "type": "faq", "settings": { "question": "Where are your products manufactured?", "answer": "<p>Designed in Australia and manufactured by long-standing partners with full quality and ethical-sourcing oversight.</p>" } },
        "faq-4": { "type": "faq", "settings": { "question": "Can I return or exchange an item?", "answer": "<p>Unused items in original packaging can be returned within 30 days. See our returns policy in the footer for the full process.</p>" } }
      },
      "block_order": ["faq-0", "faq-1", "faq-2", "faq-3", "faq-4"],
      "settings": {
        "show_section": true,
        "heading": "Frequently asked questions",
        "description": "<p>Quick answers to the questions we hear most about Sparms.</p>"
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "cta": {
      "type": "component-cta",
      "settings": {
        "show_section": true,
        "heading": "PERFORM UNDER PRESSURE with THE ORIGINAL SUN SLEEVE",
        "body": "<p>Join thousands of athletes protecting their skin with our high-performance sun sleeves.</p>",
        "button_label": "SHOP ALL"
      }
    },
    "community": {
      "type": "component-community",
      "settings": {
        "show_section": true
      }
    }
  },
  "order": [
    "main",
    "feature",
    "faqs",
    "related-products",
    "cta",
    "community"
  ]
}
